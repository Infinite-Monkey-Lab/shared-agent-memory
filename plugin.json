{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "shared-agent-memory",
  "version": "0.2.0",
  "description": "Local, shared, versioned memory for AI agents via MCP.",
  "author": { "name": "Piao-2024" },
  "repository": "https://github.com/Piao-2024/shared-agent-memory",
  "keywords": ["mcp", "memory", "sqlite", "codex", "claude-code"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Shared Agent Memory",
        "shortDescription": "Local memory shared across agents",
        "developerName": "Piao-2024",
        "category": "Productivity",
        "capabilities": ["Read", "Write"]
      }
    }
  }
}
